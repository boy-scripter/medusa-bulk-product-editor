{
  "name": "@xross-dev/medusa-bulk-product-editor",
  "version": "0.0.1",
  "description": "Medusa v2 admin plugin: bulk edit / delete (soft + hard) products with filters",
  "author": "tikmark",
  "license": "MIT",
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa-plugin",
    "medusa-v2",
    "bulk-edit",
    "products"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "prepublishOnly": "medusa plugin:build"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "^2.8.0",
    "@medusajs/cli": "^2.8.0",
    "@medusajs/framework": "^2.8.0",
    "@medusajs/icons": "^2.8.0",
    "@medusajs/js-sdk": "^2.8.0",
    "@medusajs/medusa": "^2.8.0",
    "@medusajs/ui": "^4.0.0",
    "@swc/core": "^1.7.28",
    "@tanstack/react-query": "5.64.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "6.30.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.2.11"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.8.0",
    "@medusajs/framework": "^2.8.0",
    "@medusajs/icons": "^2.8.0",
    "@medusajs/js-sdk": "^2.8.0",
    "@medusajs/medusa": "^2.8.0",
    "@medusajs/ui": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
